# ═══════════════════════════════════════════════════════════════
#  TEKMEN REVOLUTION — Contact API Environment Variables
# ═══════════════════════════════════════════════════════════════

# ── Gmail SMTP Credentials ────────────────────────────────────
# The Gmail account used to SEND emails
EMAIL_USER=steevezali@gmail.com

# Gmail App Password (NOT your regular Gmail password!)
# See the setup guide for how to generate this
EMAIL_PASS=your_gmail_app_password_here

# ── Destination Inbox ─────────────────────────────────────────
# All contact form submissions will arrive in this inbox
EMAIL_RECEIVER=steevezali@gmail.com

# ── Frontend URL (for CORS) ──────────────────────────────────
# Your deployed frontend URL (no trailing slash)
FRONTEND_URL=https://tekmen-revolution.vercel.app

# ── Server Port ───────────────────────────────────────────────
PORT=3001
